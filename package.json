{
  "name": "dsh-live-preview",
  "version": "0.2.4",
  "description": "Run and watch the app you are building inside DSH: live web iframe, Windows window capture, Android real-device/emulator mirror at 30-60fps (one-click Android emulator install), plus logs.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "live-preview",
    "android",
    "emulator",
    "windows",
    "web"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}